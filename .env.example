# FOUNDER OS — copy to .env.local and fill in. .env.local is gitignored.

# ── Email (up to 4 IMAP inboxes) ─────────────────────────────────────────
# Gmail: use an App Password (Google Account → Security → 2FA → App passwords)
INBOX_1_HOST=imap.gmail.com
INBOX_1_USER=
INBOX_1_PASS=
INBOX_1_NAME=
# INBOX_1_PORT=993            # optional, defaults to 993
INBOX_2_HOST=
INBOX_2_USER=
INBOX_2_PASS=
INBOX_3_HOST=
INBOX_3_USER=
INBOX_3_PASS=
INBOX_4_HOST=
INBOX_4_USER=
INBOX_4_PASS=

# ── Slack ────────────────────────────────────────────────────────────────
# Bot token (xoxb-…) with scopes: channels:read, channels:history, users:read
SLACK_BOT_TOKEN=

# ── Payment processors ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=            # full client implemented (balance + charges)
PAYPAL_CLIENT_ID=             # registered; client lands when keys do
PAYPAL_CLIENT_SECRET=
SQUARE_ACCESS_TOKEN=
WHOP_API_KEY=

# ── Notion ───────────────────────────────────────────────────────────────
# Internal integration secret; share target pages with the integration
NOTION_API_KEY=

# ── Launchpad Cohort ───────────────────────────────────────────────────
WEBINARJAM_API_KEY=          # account-wide key; pulls webinar registrants/attendees
TRAKYO_API_KEY=              # revenue attribution; status-only until Trakyo ships an API
GHL_API_KEY=                 # GoHighLevel Private Integration token (Settings → Private Integrations, read scopes)
GHL_LOCATION_ID=             # the LC sub-account location id (visible in the GHL URL: /v2/location/<id>/…)

# ── G-Brain ──────────────────────────────────────────────────────────────
# Defaults work: gbrain CLI on PATH, store at knowledge/brain-store
# BRAIN_PROVIDER=gbrain       # set to "stub" to disable
# GBRAIN_BIN=                 # override CLI path
# GBRAIN_STORE=               # override brain-store path
# GBRAIN_DISABLE_DIRECT_POOL=1

# ── LLM (agent & Conductor chat via Vercel AI Gateway) ───────────────────
# Without a key, agent chat reports "not configured" (no fake "connected").
AI_GATEWAY_API_KEY=           # Vercel AI Gateway key; enables agent chat
# LLM_PROVIDER=gateway        # set to "stub" for deterministic offline tests
# LLM_MODEL=anthropic/claude-sonnet-4-6   # "provider/model" routed via gateway

# ── Beehiiv (email list) ─────────────────────────────────────────────────
# Without both, the Social email-list card stays seeded dummy (no fake number).
BEEHIIV_API_KEY=             # Beehiiv API key
BEEHIIV_PUBLICATION_ID=      # publication id (pub_...)

# ── ManyChat (Instagram DM automation) ───────────────────────────────────
# Lights up the ManyChat connector on /integrations. ManyChat → Settings → API.
# The API cannot list DMs — the live /social DM inbox is fed by the webhook
# below, not by this key.
MANYCHAT_API_KEY=            # ManyChat API key
# Required shared secret for POST /api/webhooks/manychat: the request must
# carry a matching `x-manychat-secret` header (put the same value in the
# ManyChat External Request headers). Fails closed: if this is absent, every
# webhook POST is rejected — leaving it blank does NOT open the endpoint up.
# Must be a unique value in production, not reused from another integration.
MANYCHAT_WEBHOOK_SECRET=

# ── Payments processors (Finances) ───────────────────────────────────────
# Stripe is fully wired; the rest are honest "not configured" until keyed.
# STRIPE_SECRET_KEY=         # sk_live_… / sk_test_… (already above if set)
# PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET already declared above under
# "Payment processors" — one PayPal credential pair, not two.
FANBASIS_VANTAGE_KEY=       # FanBasis · Vantage
FANBASIS_LC_KEY=             # FanBasis · Launchpad Cohort
WISE_1_TOKEN=                # Wise account 1 (income + outgoing transfers)
WISE_2_TOKEN=                # Wise account 2

# ── Email send (SMTP, optional per inbox) ────────────────────────────────
# Comms email replies send for real via SMTP using each inbox's user/pass.
# Defaults: host = INBOX_n_HOST with imap.→smtp., port 465. Override per slot:
# INBOX_1_SMTP_HOST=smtp.gmail.com
# INBOX_1_SMTP_PORT=465

# ── Comms lane routing (optional) ────────────────────────────────────────
# Extra keywords that force a message into the /comms Work lane, comma-separated,
# matched against its inbox / sender / subject. Add your brands + key clients.
# Generic work signals (invoice, contract, proposal, …) are built in.
# COMMS_WORK_KEYWORDS=Acme,Northwind,Jane Client

# ── Backend V1 (PostgreSQL — Clients, Leads, LeadEvents) ─────────────────
# Local dev: a local Postgres, as below. Run `npm run db:migrate` after
# filling this in to apply lib/server/migrations/*.sql. Never commit a real
# value — this file only ever holds placeholders.
# If the password contains URL-special characters (@ : / ? # % etc.), it
# must be percent-encoded inside the connection string, or `pg` will parse
# the URL incorrectly (e.g. "p@ss/word" → "p%40ss%2Fword").
DATABASE_URL=postgresql://rekreative_app:YOUR_PASSWORD@localhost:5432/rekreative_os_dev
#
# Production (Railway): point this at Supabase's Session Pooler connection
# string (Supabase Dashboard → Project Settings → Database → Connection
# pooling → Session mode), and require TLS, e.g.:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres?sslmode=require
# lib/server/db.ts never sets `ssl` in code — sslmode must come from this
# connection string. lib/server/db.ts also never issues named prepared
# statements, so Session Pooler (and transaction-mode pgbouncer) are both
# safe to use. Migrations (`npm run db:migrate`) are never run automatically
# on boot — run them manually against production DATABASE_URL before each
# deploy that ships a schema change.

# Shared secret for the Make → REKREATIVE OS lead ingestion endpoint
# (POST /api/ingest/leads). Must be a distinct production value from
# MAKE_EVENTS_API_KEY and INGEST_META_API_KEY below — see the per-key notes
# for why (blast-radius isolation, independent rotation).
INGEST_API_KEY=replace_with_secure_random_value

# Shared secret for Make → REKREATIVE OS WhatsApp event reporting
# (POST /api/leads/whatsapp-events) — outbound sends Make performed, and
# inbound replies/delivery receipts Make relays from the WhatsApp Business
# Cloud webhook it owns. Deliberately separate from INGEST_API_KEY: this key
# can only append events/advance stage on leads that already exist, never
# create new ones, and the two should be rotatable independently. Must be a
# distinct production value, not reused from INGEST_API_KEY.
MAKE_EVENTS_API_KEY=replace_with_secure_random_value

# Shared secret for the central Make → REKREATIVE OS Meta Ads daily-snapshot
# sync (POST /api/ingest/meta-metrics) — Meta Ads Real V1. One central Make
# scenario, many clients: the payload identifies the client via
# metaAdAccountId, resolved server-side against client_meta_accounts, so
# Make never needs REKREATIVE OS's internal clientId. Deliberately separate
# from INGEST_API_KEY/MAKE_EVENTS_API_KEY — this key can only write
# meta_campaign_daily_metrics snapshots, never touch a lead, and should be
# rotatable independently. Meta OAuth/System User tokens themselves live in
# Make, never in REKREATIVE OS. Must be a distinct production value, not
# reused from the other two ingest keys above.
INGEST_META_API_KEY=replace_with_secure_random_value

# ── Supabase Auth (Session Foundation V1) ─────────────────────────────────
# Both values are public/browser-safe — Supabase Dashboard → Project
# Settings → API.
# REQUIRED AT PRODUCTION BUILD TIME, not just at runtime: Next.js statically
# inlines NEXT_PUBLIC_* values into client bundles during `next build`, and
# lib/supabase/client.ts throws during static prerendering if either is
# unset — `next build` fails without both present as build-time env vars on
# whichever host runs the build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, privileged Supabase admin key (Dashboard → Project Settings →
# API → "Secret keys", sb_secret_... format) — grants full Auth Admin API
# access (createUser, listUsers, deleteUser, ...) and bypasses RLS. Used only
# by lib/supabase/admin.ts / scripts/seed-admin.ts — not read anywhere on the
# generic request/startup path, so it is not required merely to boot the app
# or build it, only for admin bootstrap operations. NEVER prefix this
# NEXT_PUBLIC_, never import lib/supabase/admin.ts from a Client Component,
# never log its value.
SUPABASE_SECRET_KEY=

# One-time internal bootstrap input for `npm run db:seed-admin` (see
# scripts/seed-admin.ts / lib/server/bootstrap-admin.ts) — provisions the
# first REKREATIVE internal account (Supabase Auth user + profiles
# role='internal'). Internal-only: this script will never create or promote
# a client account. Remove ADMIN_EMAIL/ADMIN_PASSWORD from .env.local again
# once the account is provisioned and verified — neither needs to stay
# configured afterward.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── App ──────────────────────────────────────────────────────────────────
# Optional legacy defense-in-depth outer gate (middleware.ts, layer 2) — a
# shared-token perimeter checked BEFORE Supabase Auth, not a substitute for
# it. Fails OPEN (no perimeter at all, no error) when unset — leaving it
# blank does not fail closed the way MANYCHAT_WEBHOOK_SECRET/ingest keys do.
# NOT required for core Supabase Auth to function. Recommended set in
# production as an extra outer layer in front of /login on a public
# deployment; M2M routes always bypass it regardless (see
# lib/server/m2m-routes.ts), so enabling it cannot break Make/Meta/ManyChat.
# FOUNDER_OS_ACCESS_TOKEN=

# Override SQLite path (default: data/founder-os.db, resolved from
# process.cwd()). REKREOS currently requires a real, persistent filesystem
# for this file (and bank.db/ledger.db) — see docs/deployment.md. Deploying
# to ephemeral/serverless storage without a persistent volume will silently
# lose data, including inbound ManyChat DMs stored via this same layer.
# FOUNDER_OS_DB=
